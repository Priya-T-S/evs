# Copy to .env. Every integration is optional; EcoPulse runs with none of them.
ECOPULSE_DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/ecopulse
ECOPULSE_REDIS_URL=redis://localhost:6379/0
ECOPULSE_JWT_SECRET=replace-with-a-long-random-string

# Media: local filesystem (default) or any S3-compatible store
ECOPULSE_STORAGE_BACKEND=local
# ECOPULSE_STORAGE_BACKEND=s3
# ECOPULSE_S3_ENDPOINT_URL=http://localhost:9000
# ECOPULSE_S3_ACCESS_KEY=ecopulse
# ECOPULSE_S3_SECRET_KEY=ecopulse-secret

# AI: with a key, photo classification and the assistant use Claude.
# Without one, the transparent local heuristic classifier and intent router are used.
# ECOPULSE_ANTHROPIC_API_KEY=sk-ant-...

# External data (Open-Meteo, OpenStreetMap) needs no keys. Set false to force demo providers.
ECOPULSE_EXTERNAL_DATA_ENABLED=true

# Run the worker inside the API process (dev). In production run `python -m app.worker` separately.
ECOPULSE_EMBEDDED_WORKER=true
ECOPULSE_ENV=production   # use 'development' locally: relaxes rate limits 20x
